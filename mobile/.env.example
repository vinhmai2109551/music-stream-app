# Public base URL of the Cloudflare R2 bucket that serves audio and images
EXPO_PUBLIC_MEDIA_BASE_URL=https://your-bucket.r2.dev

# Backend API. Must end with /api.
# On a real phone use the LAN IP of the computer running the backend (e.g. 192.168.1.x), NOT localhost:
# localhost on the phone points at the phone itself. Phone and computer must be on the same Wi-Fi.
# Android emulator: http://10.0.2.2:3000/api - iOS simulator: http://localhost:3000/api
EXPO_PUBLIC_API_URL=http://192.168.1.x:3000/api
