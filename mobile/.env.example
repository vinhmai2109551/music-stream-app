# Public base URL of the Cloudflare R2 bucket that serves audio and images
EXPO_PUBLIC_MEDIA_BASE_URL=https://your-bucket.r2.dev

# Backend API. Must end with /api.
# On a real phone use the LAN IP of the computer running the backend (e.g. 192.168.1.x), NOT localhost:
# localhost on the phone points at the phone itself. Phone and computer must be on the same Wi-Fi.
# Android emulator: http://10.0.2.2:3000/api - iOS simulator: http://localhost:3000/api
EXPO_PUBLIC_API_URL=http://192.168.1.x:3000/api

# Cloudflare Turnstile (bot check on login). Site Key from dash.cloudflare.com > Turnstile; the
# Secret Key goes in backend/.env. Empty = no widget (only while the backend has no secret key).
# The value below is Cloudflare's test site key that always passes.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# On iOS / Android the widget runs in a WebView served as this hostname. Add it to the widget's
# hostname list on Cloudflare (and to TURNSTILE_ALLOWED_HOSTNAMES in backend/.env if you set it).
EXPO_PUBLIC_TURNSTILE_HOSTNAME=localhost
