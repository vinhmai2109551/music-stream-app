# Server
PORT=3000

# Database (host "db" = the docker-compose service name)
DATABASE_URL=postgresql://music:change-me@db:5432/music_stream?schema=public
# Same database seen from your computer (prisma migrate, start:dev). Leave empty inside Docker.
DATABASE_URL_LOCAL=postgresql://music:change-me@localhost:5432/music_stream?schema=public

# PostgreSQL container (must match DATABASE_URL)
POSTGRES_USER=music
POSTGRES_PASSWORD=change-me
POSTGRES_DB=music_stream

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Short-lived access token (JWT). The refresh token below renews it without logging in again.
JWT_ACCESS_EXPIRES_IN=15m
# Lifetime of the opaque refresh token, in days.
REFRESH_TOKEN_TTL_DAYS=30
# Rate limit for login / register: attempts per IP per window (strict, each is a password guess).
AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL_SECONDS=60
# Rate limit for refresh: wider, a healthy app refreshes by itself.
REFRESH_THROTTLE_LIMIT=30
REFRESH_THROTTLE_TTL_SECONDS=60
# A refresh token that was replaced less than this many seconds ago is not treated as stolen: the
# app may have been killed before saving the new token. It gets another new token of the same
# login. 0 turns this off.
REFRESH_REUSE_GRACE_SECONDS=10

# Cloudflare Turnstile (bot check on login). Create a widget at dash.cloudflare.com > Turnstile and
# copy its Secret Key here (the Site Key goes in mobile/.env). Empty = check skipped (development
# only; production refuses to start without it). The value below is Cloudflare's test secret that
# always passes, handy with the matching test site key in mobile/.env.example.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional: comma-separated hostnames the token must come from. Must contain the hostname the
# mobile app reports (EXPO_PUBLIC_TURNSTILE_HOSTNAME) and the web app's hostname. Leave empty with
# the test keys above.
TURNSTILE_ALLOWED_HOSTNAMES=

# Reverse proxies in front of the API, so the rate limiter sees the visitor's IP instead of the
# proxy's: a hop count (1 for Railway, Render...), true / false, or addresses such as "loopback".
# Use 0 or false when the API is reachable directly: the forwarding header is then written by the
# client and anyone could dodge the rate limit.
TRUST_PROXY=1

# Play counting (POST /tracks/:id/play): the same user replaying a track within this many minutes
# is not counted again; at most PLAY_THROTTLE_LIMIT calls per user and window.
PLAY_DEDUPE_MINUTES=30
PLAY_THROTTLE_LIMIT=60
PLAY_THROTTLE_TTL_SECONDS=60

# Profile pictures (POST /users/me/avatar/presign): at most this many presigned URLs per user and window.
AVATAR_THROTTLE_LIMIT=10
AVATAR_THROTTLE_TTL_SECONDS=60

# Comma-separated browser origins allowed by CORS (mobile apps are not affected)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Seed: loads the demo catalog and an admin account (idempotent: rows are upserted by id).
# Keep SEED_ON_START=false in production. With true, every start overwrites the demo artists,
# tracks and playlists with the versions in the code, and (re)creates the admin account from the
# two variables above. Set it to true for ONE start on a fresh database (or in development, where
# you want the demo data), then back to false.
SEED_ADMIN_EMAIL=admin@musicstream.local
SEED_ADMIN_PASSWORD=change-me
SEED_ON_START=false

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=music-stream-media
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Text embeddings (semantic search, recommendations, the assistant's help). Leave EMBEDDING_PROVIDER
# blank to switch those features off: their endpoints answer 503 and the rest of the API is unaffected.
#   gemini = Google Gemini embeddings (get a key at https://aistudio.google.com/apikey).
#            Content sent through the FREE tier may be used by Google to improve its products.
#   fake   = deterministic hashing, no network and no key (tests and offline development only).
# Vectors are 768 numbers long (the database columns are vector(768)).
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_API_KEY=

# Gemini API for the AI assistant and for `npm run ai:enrich` (which proposes metadata for the
# catalog). GEMINI_API_KEY may stay blank to use EMBEDDING_API_KEY: one Google AI Studio key does
# both. With neither, AI features are off: their endpoints answer 503 and the rest of the API is
# unaffected. The key stays on the server and is never sent to the app. Content sent through
# Google's FREE tier may be used by Google to improve its products.
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_MAX_TOKENS=1024
AI_DAILY_MESSAGE_LIMIT=30
# Optional: minimal | low | medium | high. Lower answers faster and uses fewer tokens.
AI_THINKING_LEVEL=
