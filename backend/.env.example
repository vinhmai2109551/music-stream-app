# Server
PORT=3000

# Database (host "db" = the docker-compose service name)
DATABASE_URL=postgresql://music:change-me@db:5432/music_stream?schema=public
# Same database seen from your computer (prisma migrate, start:dev). Leave empty inside Docker.
DATABASE_URL_LOCAL=postgresql://music:change-me@localhost:5432/music_stream?schema=public

# PostgreSQL container (must match DATABASE_URL)
POSTGRES_USER=music
POSTGRES_PASSWORD=change-me
POSTGRES_DB=music_stream

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Short-lived access token (JWT). The refresh token below renews it without logging in again.
JWT_ACCESS_EXPIRES_IN=15m
# Lifetime of the opaque refresh token, in days.
REFRESH_TOKEN_TTL_DAYS=30
# Rate limit for login / register / refresh: attempts per IP per window.
AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL_SECONDS=60

# Comma-separated browser origins allowed by CORS (mobile apps are not affected)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Seed (SEED_ON_START=true runs the idempotent seed every time the API starts)
SEED_ADMIN_EMAIL=admin@musicstream.local
SEED_ADMIN_PASSWORD=change-me
SEED_ON_START=true

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=music-stream-media
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
