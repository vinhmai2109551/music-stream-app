# Base URL of the API, including the /api prefix. Baked into the bundle at build time.
VITE_API_URL=http://localhost:3000/api

# Cloudflare Turnstile Site Key for the login form. Leave it empty when the API has no
# TURNSTILE_SECRET_KEY (the widget is then not shown). Cloudflare's test key that always passes is
# 1x00000000000000000000AA, to be used with the test secret in backend/.env.example.
VITE_TURNSTILE_SITE_KEY=
